# Limite por fotografia, em MiB (inteiro positivo; padrão: 5).
MAX_IMAGE_SIZE_MB=5

# Padrão local. Alternativa independente: gemini.
IA_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60

# Chave obtida no Google AI Studio; mantenha apenas no ambiente local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# O CLIP usa o cache padrão do Hugging Face; opcionalmente personalize:
# HF_HOME=/caminho/para/cache
# Este arquivo não é carregado automaticamente. Consulte o README para exportá-lo.
# Nunca inclua credenciais neste exemplo nem as versione no repositório.
